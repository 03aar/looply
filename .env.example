# ========================================
# DATABASE CONFIGURATION
# ========================================

# Local Development (SQLite - Easy Setup)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - Recommended)
# Get from: Supabase, Railway, or your PostgreSQL provider
# DATABASE_URL="postgresql://user:password@host:5432/looply?pgbouncer=true&connection_limit=1"

# Optional: Read replica for scaling (10,000+ users)
# DATABASE_READ_URL="postgresql://user:password@read-replica-host:5432/looply"


# ========================================
# AUTHENTICATION (NextAuth.js)
# ========================================

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Your app URL
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""


# ========================================
# EMAIL CONFIGURATION
# ========================================

# The email address to send from
EMAIL_FROM="noreply@looply.app"

# Option 1: Resend (Recommended - Easy Setup)
# Get from: https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxx"

# Option 2: SendGrid
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxx"

# Option 3: Custom SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_SECURE="false"


# ========================================
# REDIS (Optional - For Advanced Caching)
# ========================================

# Leave empty for development (uses in-memory caching)
# For production with multiple servers, use Redis
# REDIS_URL="redis://localhost:6379"


# ========================================
# MONITORING & LOGGING
# ========================================

# Log level: debug, info, warn, error
LOG_LEVEL="info"

# Enable file logging (automatically enabled in production)
# LOG_TO_FILE="true"

# Sentry Error Tracking (Optional but recommended for production)
# Get from: https://sentry.io
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""


# ========================================
# SECURITY & RATE LIMITING
# ========================================

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Rate limit multiplier (1.0 = default, 2.0 = 2x more lenient)
# RATE_LIMIT_MULTIPLIER="1.0"


# ========================================
# FILE UPLOADS (Optional)
# ========================================

# AWS S3 for file storage
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="looply-uploads"

# Or Cloudinary
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""


# ========================================
# ANALYTICS (Optional)
# ========================================

# Google Analytics
# NEXT_PUBLIC_GA_ID=""

# Plausible Analytics (Privacy-friendly)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""


# ========================================
# FEATURE FLAGS
# ========================================

# Enable/disable features
# ENABLE_EMAIL_NOTIFICATIONS="true"
# ENABLE_ANALYTICS="true"
# ENABLE_FILE_UPLOADS="false"


# ========================================
# ENVIRONMENT
# ========================================

# Set automatically by hosting platform
# NODE_ENV="production"
